# ==============================================================================
# CONFIGURAÇÕES DE AMBIENTE - COPIE PARA .env E AJUSTE OS VALORES
# ==============================================================================

# -----------------------------------------------------------------------------
# VISÃO COMPUTACIONAL (vision_monitor.py)
# -----------------------------------------------------------------------------
# Fonte de vídeo: 0 para webcam local, URL RTSP, ou "mock" para simulação (Codespaces)
VIDEO_SOURCE=0

# Região de Interesse (ROI) - coordenadas [x, y, width, height] para isolar a peça móvel
# Defina como "auto" para selecionar interativamente na primeira execução, ou use JSON: [x,y,w,h]
ROI_COORDS=[100,100,320,240]

# Calibração: duração em segundos para estabelecer baseline de movimento normal
CALIBRATION_SECONDS=3

# Thresholds de anomalia (métrica de magnitude média do Optical Flow)
ALERT_THRESHOLD=1.8
CRITICAL_THRESHOLD=3.5

# Debounce: frames consecutivos acima do threshold para confirmar mudança de estado
ALERT_DEBOUNCE_FRAMES=10
CRITICAL_DEBOUNCE_FRAMES=5

# Parâmetros do Dense Optical Flow (Farnebäck)
FLOW_PYR_SCALE=0.5
FLOW_LEVELS=3
FLOW_WINSIZE=15
FLOW_ITERATIONS=3
FLOW_POLY_N=5
FLOW_POLY_SIGMA=1.2
FLOW_FLAGS=0

# Overlay HUD na janela OpenCV
SHOW_HUD=true
TARGET_FPS=30

# -----------------------------------------------------------------------------
# BACKEND / API (api.py)
# -----------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=sqlite:///./evolution.db

# CORS para o dashboard Streamlit
CORS_ORIGINS=["http://localhost:8501","http://127.0.0.1:8501"]

# -----------------------------------------------------------------------------
# ESP32 CONTROLLER (esp32_controller.ino)
# -----------------------------------------------------------------------------
ESP32_IP=192.168.1.50
ESP32_PORT=80
ESP32_TIMEOUT_SECONDS=3

# Lógica do Relé: true = Active LOW (relé liga com LOW), false = Active HIGH
RELAY_ACTIVE_LOW=true

# -----------------------------------------------------------------------------
# NOTIFICAÇÕES (Webhook Discord/Slack ou Telegram)
# -----------------------------------------------------------------------------
# Webhook URL (Discord/Slack) - deixe vazio se não usar
WEBHOOK_URL=

# Telegram Bot (alternativo ao webhook) - deixe vazio se não usar
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Cooldown de notificações (segundos)
ALERT_COOLDOWN_SECONDS=60
CRITICAL_COOLDOWN_SECONDS=0  # Imediato para CRÍTICO

# -----------------------------------------------------------------------------
# DASHBOARD (dashboard.py)
# -----------------------------------------------------------------------------
DASHBOARD_REFRESH_SECONDS=2
MAX_TELEMETRY_POINTS=300
CSV_EXPORT_PATH=./exports

# Diretórios de evidências e logs
CAPTURES_DIR=./captures
LOGS_DIR=./logs

# -----------------------------------------------------------------------------
# AUTENTICAÇÃO JWT (site logável + APK)
# -----------------------------------------------------------------------------
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_EXPIRE_MINUTES=480

# -----------------------------------------------------------------------------
# IA DE DIAGNÓSTICO (Gemini grátis | OpenRouter grátis | local ilimitado)
# -----------------------------------------------------------------------------
# AI_PROVIDER: "gemini" (free tier) | "openrouter" (modelos free) | "local" (sem rede, ilimitado)
AI_ENABLED=true
AI_PROVIDER=local
# GEMINI_API_KEY=AIza...
# OPENROUTER_API_KEY=sk-or-v1-...
# AI_MODEL=gemini-2.0-flash   # ou deepseek/deepseek-r1:free
AI_COOLDOWN_SECONDS=30
ERROR_WINDOW_SECONDS=300
ERROR_BURST_LIMIT=5
ERROR_BURST_COOLDOWN=120

# ==============================================================================