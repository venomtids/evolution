# ==============================================================================
# CONFIGURAÇÕES DE AMBIENTE - COPIE PARA .env E AJUSTE OS VALORES
# ==============================================================================

# -----------------------------------------------------------------------------
# VISÃO COMPUTACIONAL (vision_monitor.py)
# -----------------------------------------------------------------------------
# Fonte de vídeo: 0 para webcam local, URL RTSP, ou "mock" para simulação (Codespaces)
VIDEO_SOURCE=0

# Região de Interesse (ROI) - coordenadas [x, y, width, height] para isolar a peça móvel
# Defina como "auto" para selecionar interativamente na primeira execução, ou use JSON: [x,y,w,h]
ROI_COORDS=[100,100,320,240]

# Calibração: duração em segundos para estabelecer baseline de movimento normal
CALIBRATION_SECONDS=3

# Thresholds de anomalia (métrica de magnitude média do Optical Flow)
ALERT_THRESHOLD=1.8
CRITICAL_THRESHOLD=3.5

# Debounce: frames consecutivos acima do threshold para confirmar mudança de estado
ALERT_DEBOUNCE_FRAMES=10
CRITICAL_DEBOUNCE_FRAMES=5

# Parâmetros do Dense Optical Flow (Farnebäck)
FLOW_PYR_SCALE=0.5
FLOW_LEVELS=3
FLOW_WINSIZE=15
FLOW_ITERATIONS=3
FLOW_POLY_N=5
FLOW_POLY_SIGMA=1.2
FLOW_FLAGS=0

# Overlay HUD na janela OpenCV
SHOW_HUD=true
TARGET_FPS=30

# -----------------------------------------------------------------------------
# APRENDIZADO DO PADRÃO DA MÁQUINA (pattern_learner.py — SEM RÓTULOS)
# -----------------------------------------------------------------------------
# A IA observa apenas o movimento e descobre sozinha o comportamento normal,
# os regimes de operação e os limites de anomalia. Nenhum status/label é usado.
PATTERN_LEARNING_ENABLED=true
# Tempo de observação inicial quando ainda não há padrão salvo (segundos)
PATTERN_LEARNING_SECONDS=60
# Reaprender do zero a cada inicialização (ignora o modelo salvo)
PATTERN_RELEARN_ON_START=false
# Janela de análise (amostras) e passo de deslize
PATTERN_WINDOW=40
PATTERN_STRIDE=5
# Taxa fixa de amostragem do movimento (alinha histórico e ao vivo)
PATTERN_SAMPLE_HZ=4
# Frequência de comparação com o padrão e debounce (em avaliações)
PATTERN_EVAL_SECONDS=0.5
PATTERN_ALERT_EVALS=4
PATTERN_CRITICAL_EVALS=8
# Padrão anômalo pode elevar o estado? (CRÍTICO liga o E-Stop: use com cautela)
PATTERN_ESCALATE_ALERTA=true
PATTERN_ESCALATE_CRITICO=false
# >1 = mais sensível; <1 = mais tolerante
PATTERN_SENSITIVITY=1.0
# Frações mínima/máxima das janelas tratadas como padrão (0..1)
PATTERN_MIN_CORE_FRACTION=0.50
PATTERN_MAX_CORE_FRACTION=0.99
# Adaptação lenta ao drift natural (carga/velocidade/temperatura)
PATTERN_ADAPT_ENABLED=true
PATTERN_ADAPT_INTERVAL_SECONDS=300

# -----------------------------------------------------------------------------
# BACKEND / API (api.py)
# -----------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=sqlite:///./evolution.db

# CORS para o dashboard Streamlit
CORS_ORIGINS=["http://localhost:8501","http://127.0.0.1:8501"]

# -----------------------------------------------------------------------------
# ESP32 CONTROLLER (esp32_controller.ino)
# -----------------------------------------------------------------------------
# Para teste local: use 127.0.0.1 e o servidor mock Python abaixo.
# Para hardware real: IP da rede local do ESP32 (ex: 192.168.1.xx)
ESP32_IP=127.0.0.1
ESP32_PORT=80
ESP32_TIMEOUT_SECONDS=3

# Lógica do Relé: true = Active LOW (relé liga com LOW), false = Active HIGH
RELAY_ACTIVE_LOW=true

# -----------------------------------------------------------------------------
# NOTIFICAÇÕES (Webhook Discord/Slack ou Telegram)
# -----------------------------------------------------------------------------
# Webhook URL (Discord/Slack) - deixe vazio se não usar
WEBHOOK_URL=

# Telegram Bot (alternativo ao webhook) - deixe vazio se não usar
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Cooldown de notificações (segundos)
ALERT_COOLDOWN_SECONDS=60
CRITICAL_COOLDOWN_SECONDS=0  # Imediato para CRÍTICO

# -----------------------------------------------------------------------------
# DASHBOARD (dashboard.py)
# -----------------------------------------------------------------------------
DASHBOARD_REFRESH_SECONDS=2
MAX_TELEMETRY_POINTS=300
CSV_EXPORT_PATH=./exports

# -----------------------------------------------------------------------------
# SENSOR DE TEMPERATURA (thermal monitoring + camera integration)
# -----------------------------------------------------------------------------
TEMP_SENSOR_ENABLED=false
TEMP_SENSOR_TYPE=mock        # mock|sensor|webhook
TEMP_MAX_ALERTA=60.0
TEMP_MAX_CRITICO=75.0
TEMP_SOURCE=mock             # mock|file|sensor|webhook
TEMP_FILE_PATH=logs/temperature.log

# Diretórios de evidências e logs
CAPTURES_DIR=./captures
# Salvar frames de evidência (contém imagem da câmera!). true=ligado, false=desligado.
EVIDENCE_CAPTURE_ENABLED=false
LOGS_DIR=./logs

# -----------------------------------------------------------------------------
# AUTENTICAÇÃO JWT (site logável + APK)
# -----------------------------------------------------------------------------
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_EXPIRE_MINUTES=480

# -----------------------------------------------------------------------------
# IA DE DIAGNÓSTICO
# -----------------------------------------------------------------------------
# AI_PROVIDER:
#   "ml"         → IA open-source treinada na nossa situação (scikit-learn). PADRÃO.
#                  Requer treino: `python train_ai.py` ou POST /ml/train (ou botão no dashboard).
#                  Sem modelo treinado → fallback automático p/ "local".
#   "local"      → heurística ISO-10816, sem rede, ilimitado (fallback sempre disponível)
#   "gemini"     → Google Gemini API (free tier; exige GEMINI_API_KEY)
#   "openrouter" → OpenRouter, modelos grátis (exige OPENROUTER_API_KEY)
AI_ENABLED=true
AI_PROVIDER=ml
# GEMINI_API_KEY=AIza...
# OPENROUTER_API_KEY=sk-or-v1-...
# AI_MODEL=gemini-2.0-flash   # ou deepseek/deepseek-r1:free
AI_COOLDOWN_SECONDS=30
ERROR_WINDOW_SECONDS=300
ERROR_BURST_LIMIT=5
ERROR_BURST_COOLDOWN=120

# ==============================================================================